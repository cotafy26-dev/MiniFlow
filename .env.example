# Supabase project — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Used only by src/lib/supabase/server.ts's
# createAdminClient() and by scripts/*.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string — Dashboard → Project Settings →
# Database → Connection string → URI. Used only by scripts/*.mjs, never by
# the Next.js app itself.
DATABASE_URL=

# Canonical site URL. Used to build Supabase Auth's emailRedirectTo /
# OAuth redirectTo links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — NOT read by the Next.js app. Consumed by `supabase start`
# (local dev, via supabase/config.toml's [auth.external.google] block) and
# mirrored manually in the Supabase Dashboard → Authentication → Providers
# → Google for staging/production. See README.md for full setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# development | staging | production — informational, used for log tagging.
NEXT_PUBLIC_APP_ENV=development

# Resend — https://resend.com/api-keys. Platform-level credential (one
# account sends transactional email for every tenant), server-only.
# EMAIL_FROM defaults to Resend's onboarding@resend.dev test sender if
# unset; switch it to your own address once its domain is verified in
# the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=

# Web Push — generated locally, no external account needed:
# node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY
# (the browser needs it client-side to call pushManager.subscribe()).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Gemini — platform-level credential (one key powers every tenant's "AI
# Tool" mini-apps), generated at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Sites — public subdomain hosting for admin-uploaded index.html pages
# (src/proxy.ts + src/app/site/[subdomain]/route.ts). Leave blank until
# you have a real domain; the feature is inert without it. Once you do,
# point a wildcard DNS record (*.yourdomain.com) at wherever this app is
# reachable and set this to the bare domain (e.g. "yourdomain.com", no
# scheme, no leading dot).
APPS_BASE_DOMAIN=
